# Local development with Supabase CLI defaults
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key_from_supabase_start
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key_from_supabase_start

# AI provider. Leave AI_API_KEY empty to use the mock local fallback.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=

# v4 Phase 12: aftermath email pipeline
RESEND_API_KEY=
EMAIL_FROM=system@self-distill.art
SITE_ORIGIN=https://self-distill.art
# CRON_SECRET protects /api/cron/post-session. Vercel injects this automatically.
# Leave empty in local dev to bypass auth (mock email mode kicks in).
CRON_SECRET=

# Optional SMS provider — not wired in v4 but reserved for演出 prep
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
